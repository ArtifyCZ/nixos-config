{
    "editor.formatOnSave": true,
    "nix.enableLanguageServer": true,
    "nix.serverPath": "nixd",
    "nix.serverSettings": {
        "nixd": {
            "nixpkgs": {
                "expr": "import (builtins.getFlake \"/etc/nixos\").inputs.nixpkgs { }"
            },
            "formatting": {
                "command": [
                    "nixfmt"
                ]
            },
            "options": {
                "nixos": {
                    "expr": "(builtins.getFlake \"/etc/nixos\").nixosConfigurations.artifydesktop"
                }
            }
        }
    }
}